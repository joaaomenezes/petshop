# Copy to .env.local. NEXT_PUBLIC_* must use only public/publishable keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stage 4: disabled until configured. Never put private keys in NEXT_PUBLIC_*.
CHECKOUT_MODE=disabled
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
CHECKOUT_BASE_URL=
CHECKOUT_CRON_SECRET=
CHECKOUT_EXPIRATION_JOB_READY=false
